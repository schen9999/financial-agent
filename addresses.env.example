# Copy to .addresses.env (gitignored) on each host that runs the runbook's
# commands or captures output (laptop, operator, node 2), and fill in the
# values. scripts/redact.py replaces each value with the placeholder named
# after its variable (NODE2_PUBLIC_IP -> <node2-public-ip>); the runbook's
# commands read the values with:  set -a; . ~/financial-agent/.addresses.env; set +a
NODE2_PUBLIC_IP=203.0.113.10        # vm-a10-inst-2's public address
OKE_EGRESS_IP=203.0.113.20          # the OKE cluster's NAT egress address
STREAMLIT_LB_IP=203.0.113.30        # the 2026-10-08 INCIDENT load balancer (outside change, deleted 02:52Z), not the live one
PUBLIC_UI_LB_IP=203.0.113.40        # the live public-UI load balancer (scripts/public_ui_up.sh, since 2026-10-08 03:12Z)
OKE_API_PRIVATE_IP=192.0.2.3        # the cluster's private API endpoint
OKE_NODE_1=192.0.2.11               # OKE worker nodes, in the order of
OKE_NODE_2=192.0.2.12               # eval/runs/oke-node-capacity-2026-10-05.txt
OKE_NODE_3=192.0.2.13
OKE_NODE_4=192.0.2.14
OKE_OPERATOR_HOST=o-abcdef         # the operator instance's hostname (OCI-generated suffix)
OKE_VCN_DOMAIN=abcdef.oraclevcn.com # the VCN's DNS domain
