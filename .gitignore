# Secrets — never commit
.env
.streamlit/secrets.toml

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Eval artifacts
eval_findings/
# Raw eval-run pod logs: bulky (MBs of base64 findings dumps) and fully
# redundant — the dump payloads are bit-identical to the committed
# eval/runs/raw/<run>-findings/ dirs, which stay TRACKED because committed
# harnesses read them (eval/section_attribution.py, eval/build_holdout.py).
eval/runs/raw/*.log

# Cached SEC filing text
sec_filings/

# Fine-tuned model artifacts (large — produced by fine_tune_financial.ipynb)
adapters/
*.gguf
*-merged/
*.zip
financial-lora-build/

# Terraform — state holds the RDS password; tfvars holds your IP
**/.terraform/
*.tfstate
*.tfstate.*
*.tfstate.backup
crash.log
crash.*.log
infra/terraform.tfvars
# keep .terraform.lock.hcl and *.tf committed
.venv-wsl/
.streamlit/

# Local presenter notes — never committed
notes/

# Answer key for the unlabeled four-arm judge-validation sample — kept
# outside the repo; eval/build_fourarm_holdout.py writes it here on a rerun
eval/judge_validation/fourarm_holdout_key.csv

# Answer key for the unlabeled calibration batch; eval/build_calibration_batch.py
# writes it here, keep it out of the public repo while unlabeled
eval/judge_validation/calibration_batch_key.csv

# Answer key for the judge-SUPPORTED relabel sample (source set per row)
eval/judge_validation/relabel_S_key.csv

# Answer key for the judge-UNSUPPORTED/INFERENCE relabel sample
eval/judge_validation/relabel_UI_key.csv
