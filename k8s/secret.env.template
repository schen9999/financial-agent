# Template for the `app-secrets` Secret. Do NOT fill this file in and commit it.
#
# `make deploy` creates the Secret directly from your local .env:
#   kubectl -n financial-agent create secret generic app-secrets \
#     --from-env-file=.env --dry-run=client -o yaml | kubectl apply -f -
#
# Keys the stack reads (same set as .env.example):
ANTHROPIC_API_KEY=            # required — section generation, synthesis, judge
NEWS_API_KEY=                 # required for the news tool
PINECONE_API_KEY=             # required for the RAG sections (absent => RAG disabled)
# LangSmith tracing (optional; legacy LANGCHAIN_* names also accepted)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=
LANGSMITH_PROJECT=
# REDIS_URL / DATABASE_URL may exist in your .env for local dev; in-cluster they
# are overridden by app-config (Redis) and infra-secrets (Postgres) because both
# are listed after app-secrets in envFrom. The `infra-secrets` Secret
# (POSTGRES_PASSWORD + DATABASE_URL) is generated by `make deploy` on first run
# with a random password and lives only in the cluster.
