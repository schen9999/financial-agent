# BuildKit per-Dockerfile ignore for Dockerfile.k8s. Differs from .dockerignore
# (the ECS image) by KEEPING app.py, .streamlit/, and grounding_check.py — the
# K8s image also serves the Streamlit UI and (Phase 2) the Argo eval steps.

# Secrets — never bake into the image
.env
.env.*
*.env

# VCS / CI / infra (not needed at runtime)
.git
.gitignore
.gitattributes
.github/
infra/
k8s/

# Python caches / local venv
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Notebooks, data, models, eval artifacts
*.ipynb
data/
docs/
adapters/
*.gguf
*-merged/
*.zip
financial-lora-build/
financial-lora-merged/
sec_filings/
eval_findings/
.devcontainer/

# Dev/eval scripts not needed in the running pods (grounding_check.py IS kept)
tests/
benchmark_timing.py
compare_synthesis.py
scripts/

# Docs + alternate requirements (this image uses requirements.txt)
README.md
*.md
requirements-api.txt

# Docker files themselves
Dockerfile
Dockerfile.k8s
.dockerignore
Dockerfile.k8s.dockerignore
Makefile
