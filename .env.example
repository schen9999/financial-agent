# ── Core API keys ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-key
NEWS_API_KEY=your-newsapi-key
PINECONE_API_KEY=your-pinecone-key

# ── Infrastructure ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379        # cache + Celery broker/backend
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ── Two-stage retrieval / cross-encoder reranking ───────────────────────────
# When off (default) retrieval is single-stage top-3 cosine — identical to the
# original behaviour. When on, stage 1 over-retrieves RERANK_CANDIDATES and a
# CPU-friendly cross-encoder reranks down to RERANK_TOP_N.
RERANKING_ENABLED=false
RERANK_CANDIDATES=20
RERANK_TOP_N=3
RERANK_MODEL=BAAI/bge-reranker-base
# Chunks retrieved when reranking is off (the eval harness sets it per arm).
# BASELINE_TOP_K=3

# ── Local fine-tuned model (LoRA experiment) ────────────────────────────────
# When on, the QLoRA-fine-tuned Qwen2.5-1.5B (vLLM on the k3s nodes, or Ollama
# locally) replaces Haiku for the 2 trained sections: Financial Health and Risk Factors. Recent
# Developments and SEC Filing Highlights always stay with Haiku (deterministic
# training targets couldn't be built for them). Off by default — Haiku serves
# every section.
USE_LOCAL_MODEL=false
LOCAL_MODEL_NAME=financial-lora
LOCAL_MODEL_URL=http://localhost:11434
# Protocol LocalChat speaks to LOCAL_MODEL_URL: "ollama" (default, /api/chat)
# or "openai" (/v1/chat/completions — vLLM, or Ollama's OpenAI-compatible API).
LOCAL_MODEL_BACKEND=ollama
# Per-request timeout (seconds) and max_tokens for the local model.
# LOCAL_MODEL_TIMEOUT=180
# LOCAL_MODEL_MAX_TOKENS=512
# Weights directory, recorded in eval provenance only (make vm-vllm sets it).
# LOCAL_MODEL_DIR=qwen-ft

# ── Multi-agent orchestration ───────────────────────────────────────────────
# When off (default) briefs use the single-agent pipeline (the A/B control).
# When on, brief generation routes through a supervisor graph:
# planner → research → grounding-critic → supervisor, with a bounded revision
# loop. Same brief schema and API contract either way.
MULTI_AGENT_ENABLED=false
# Max unsupported-claim % the inline critic tolerates before sending the brief
# back to the research agent for revision.
CRITIC_MAX_UNSUPPORTED_PCT=5
# Max critic→research revision passes before the brief is accepted as-is.
MAX_REVISIONS=2

# ── LangSmith observability ─────────────────────────────────────────────────
# The key is read from the environment (never hardcoded). Use the LANGSMITH_*
# names (the code reads them first; the ECS secret uses LANGSMITH_API_KEY).
# The legacy names below also work, through agent/tracing.py's fallback;
# set one name per value, not both.
LANGSMITH_API_KEY=your-langsmith-key
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=financial-agent
# Legacy aliases of LANGSMITH_API_KEY and LANGSMITH_PROJECT:
# LANGCHAIN_API_KEY=your-langsmith-key
# LANGCHAIN_PROJECT=financial-agent

# ── MCP server ──────────────────────────────────────────────────────────────
# Transport (stdio | streamable-http | sse), bind address/port for HTTP, and
# the per-tool-call timeout (seconds). Kubernetes sets the first three itself.
# MCP_TRANSPORT=stdio
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
# MCP_TOOL_TIMEOUT=30

# ── Eval harness only ───────────────────────────────────────────────────────
# Set by grounding_check.py to bypass the Redis exact-key cache so A/B arms
# never return another arm's cached brief. Leave unset for normal operation.
# BYPASS_CACHE=true
# OCI Object Storage write PAR for best-effort eval artifact archival (off
# when unset; never commit a PAR).
# EVAL_ARTIFACTS_PUT_URL=
